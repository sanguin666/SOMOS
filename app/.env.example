# Copy this file to .env for local development.
#
# URL of the backend API. Expo inlines EXPO_PUBLIC_* vars at build time.
#
# - `npm run web` on the same machine as the backend: the default below works.
# - Expo Go on a physical phone: replace localhost with your dev machine's
#   LAN IP (e.g. http://192.168.1.23:3000) — the phone can't resolve
#   "localhost" as your computer. Find your IP with `ipconfig getifaddr en0`
#   (macOS) or `hostname -I` (Linux), and make sure the phone is on the
#   same Wi-Fi network as the backend.
EXPO_PUBLIC_API_URL=http://localhost:3000
